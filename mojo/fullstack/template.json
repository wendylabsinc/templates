{
    "name": "fullstack",
    "description": "Fullstack app: pure-Mojo backend (wendynet + SQLite/V4L2/ALSA FFI, Mojo GPU kernel route) + React/shadcn frontend",
    "variables": [
        {
            "name": "APP_ID",
            "description": "Application identifier",
            "type": "string",
            "required": true,
            "prompt": "App ID"
        },
        {
            "name": "PORT",
            "description": "Primary HTTP port",
            "type": "integer",
            "default": 9006,
            "prompt": "HTTP port",
            "validate": { "min": 1, "max": 65535 }
        }
    ]
}
