{
    "name": "mac-llm",
    "description": "Native Apple Silicon MAX chat with Open WebUI",
    "variables": [
        {"name": "APP_ID", "description": "Application identifier", "type": "string", "required": true, "prompt": "App ID"},
        {"name": "PORT", "description": "Open WebUI port", "type": "integer", "default": 8080, "prompt": "Browser chat port", "validate": {"min": 1, "max": 65535}},
        {"name": "MAX_MODEL", "description": "Hugging Face model served by MAX on Metal", "type": "string", "default": "HuggingFaceTB/SmolLM2-135M-Instruct", "prompt": "MAX model"}
    ]
}
