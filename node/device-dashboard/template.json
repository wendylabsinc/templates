{
  "name": "device-dashboard",
  "description": "Device dashboard with camera, audio, GPU, and persistent data",
  "variables": [
    {
      "name": "APP_ID",
      "description": "Application identifier",
      "type": "string",
      "required": true,
      "prompt": "App ID"
    },
    {
      "name": "PORT",
      "description": "Primary HTTP port",
      "type": "integer",
      "default": 5001,
      "prompt": "HTTP port",
      "validate": {
        "min": 1,
        "max": 65535
      }
    }
  ]
}
