{
    "appId": "{{.APP_ID}}",
    "version": "0.1.0",
    "platform": "linux",
    "entitlements": [
        {
            "type": "admin"
        },
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "build"
        },
        {
            "type": "persist",
            "name": "{{.APP_ID}}-home",
            "path": "/home/hermes"
        },
        {
            "type": "persist",
            "name": "{{.APP_ID}}-workspace",
            "path": "/workspace"
        },
        {
            "type": "persist",
            "name": "{{.APP_ID}}-state",
            "path": "/state"
        },
        {
            "type": "persist",
            "name": "{{.APP_ID}}-buildkit-cache",
            "path": "/var/lib/buildkit"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": {{.PORT}} },
        "timeoutSeconds": 300
    },
    "hooks": {
        "postStart": {
            "cli": "wendy utils open-browser https://${WENDY_HOSTNAME}:{{.PORT}}"
        }
    }
}
