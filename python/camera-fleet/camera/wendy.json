{
    "appId": "{{.APP_ID}}.camera",
    "version": "0.1.0",
    "platform": "linux/arm64",
    "isolation": "isolated",
    "entitlements": [
        {
            "type": "network",
            "mode": "mesh",
            "serviceCIDR": "10.99.0.0/16",
            "ports": [
                { "host": {{.CAMERA_PORT}}, "container": {{.CAMERA_PORT}} }
            ]
        },
        { "type": "camera" }
    ],
    "readiness": {
        "tcpSocket": { "port": {{.CAMERA_PORT}} },
        "timeoutSeconds": 30
    }
}
