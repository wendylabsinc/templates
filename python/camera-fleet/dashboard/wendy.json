{
    "appId": "{{.APP_ID}}.dashboard",
    "version": "0.1.0",
    "platform": "linux/arm64",
    "isolation": "isolated",
    "entitlements": [
        {
            "type": "network",
            "mode": "mesh",
            "serviceCIDR": "10.99.0.0/16",
            "ports": [
                { "host": {{.DASHBOARD_PORT}}, "container": {{.DASHBOARD_PORT}} }
            ]
        }
    ],
    "readiness": {
        "tcpSocket": { "port": {{.DASHBOARD_PORT}} },
        "timeoutSeconds": 30
    },
    "hooks": {
        "postStart": { "openURL": "http://${WENDY_HOSTNAME}:{{.DASHBOARD_PORT}}" }
    }
}
