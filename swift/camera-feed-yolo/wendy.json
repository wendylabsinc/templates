{
    "appId": "camera-feed-yolo",
    "version": "0.1.0",
    "platform": "linux",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "camera"
        },
        {
            "type": "gpu"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 6006 },
        "timeoutSeconds": 180
    },
    "hooks": {
        "postStart": {
            "cli": "wendy utils open-browser http://${WENDY_HOSTNAME}:6006"
        }
    }
}
