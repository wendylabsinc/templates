{
    "name": "webcam",
    "description": "Generic USB/UVC webcam: GStreamer WebRTC with MJPEG fallback",
    "variables": [
        {
            "name": "APP_ID",
            "description": "Application identifier",
            "type": "string",
            "required": true,
            "prompt": "App ID"
        },
        {
            "name": "PORT",
            "description": "HTTP port",
            "type": "integer",
            "default": 3003,
            "prompt": "HTTP port",
            "validate": { "min": 1, "max": 65535 }
        }
    ]
}
